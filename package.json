{
  "name": "@magland/mochi",
  "version": "0.3.1",
  "description": "A self-hosted git forge with the shape of GitHub: browsing, in-browser editing, issues, pull requests, Actions-compatible workflows, static sites, and Git LFS, from one small server.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magland/mochiforge.git"
  },
  "homepage": "https://github.com/magland/mochiforge#readme",
  "bugs": "https://github.com/magland/mochiforge/issues",
  "keywords": [
    "git",
    "forge",
    "self-hosted",
    "git-http",
    "git-lfs",
    "issues",
    "pull-requests",
    "static-site"
  ],
  "bin": {
    "mochi": "dist/index.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node scripts/build-info.js",
    "dev": "tsx src/index.ts serve example-root",
    "start": "node dist/index.js serve",
    "example": "bash scripts/create-example.sh example-root",
    "test": "npm run test:unit && bash scripts/smoke.sh",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "smoke": "bash scripts/smoke.sh",
    "smoke:slow": "SMOKE_SLOW=1 bash scripts/smoke.sh",
    "bump": "bash scripts/bump.sh",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "aws4fetch": "^1.0.20",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.4",
    "markdown-it": "^15.0.1",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "sanitize-html": "^2.17.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.4.0",
    "@types/sanitize-html": "^2.16.1",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
